<UserControl x:Class="CairoDesktop.MenuBarExtensions.SystemMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <Style TargetType="Image">
            <Setter Property="Width"
                    Value="16" />
            <Setter Property="Height"
                    Value="16" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode"
                    Value="HighQuality" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource RunchFontFamily}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource RunchFontSize}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource RunchForeground}" />
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <!-- RamMonitorWidget -->
        <Border Background="{DynamicResource RunchRamMonitor}"
                Padding="5,0,5,0">
            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource RunchRamIcon}"
                       Margin="0,0,4,0" />
                <TextBlock Text="{Binding RamUsage}" />
            </StackPanel>
        </Border>
        <!-- CPUMonitorWidget -->
        <Border Background="{DynamicResource RunchCpuMonitor}"
                Padding="5,0,5,0">
            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource RunchCpuIcon}"
                       Margin="0,0,4,0" />
                <TextBlock Text="{Binding CpuUsage}"
                           Margin="0,0,8,0" />
                <Image Source="{DynamicResource RunchTempIcon}" />
                <TextBlock Text="{Binding CpuTemperature}"
                           ToolTip="{Binding CpuTemperatureToolTip}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
