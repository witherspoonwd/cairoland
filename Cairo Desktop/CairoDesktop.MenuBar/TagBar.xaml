<UserControl x:Class="CairoDesktop.MenuBar.TagBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             Height="{DynamicResource RunchBarHeight}"
             Background="{DynamicResource RunchDark}"
             PreviewMouseWheel="TagBar_PreviewMouseWheel">
    <ItemsControl ItemsSource="{Binding Tags}"
                  Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="TagBorder"
                        Height="{DynamicResource RunchBarHeight}"
                        Padding="4,0,4,0"
                        Background="Transparent"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding ViewCommand}" />
                        <MouseBinding MouseAction="RightClick"
                                      Command="{Binding MoveHereCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <TextBlock x:Name="TagLabel"
                                   Text="{Binding Label}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource RunchFontFamily}"
                                   FontSize="{DynamicResource RunchFontSize}"
                                   Foreground="{DynamicResource RunchForeground}" />
                        <!-- underline marking a tag that has windows -->
                        <Rectangle x:Name="OccupiedMark"
                                   Height="2"
                                   RadiusX="1"
                                   RadiusY="1"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,0,0,2"
                                   Fill="{DynamicResource RunchWindowIndicator}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="TagBorder"
                             Property="IsMouseOver"
                             Value="True">
                        <Setter TargetName="TagBorder"
                                Property="Background"
                                Value="{DynamicResource RunchTopHover}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsOccupied}"
                                 Value="True">
                        <Setter TargetName="OccupiedMark"
                                Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsUrgent}"
                                 Value="True">
                        <Setter TargetName="TagBorder"
                                Property="Background"
                                Value="{DynamicResource TilingTagUrgentBackground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}"
                                 Value="True">
                        <Setter TargetName="TagBorder"
                                Property="Background"
                                Value="{DynamicResource RunchTopSelected}" />
                        <Setter TargetName="OccupiedMark"
                                Property="Fill"
                                Value="{DynamicResource RunchWindowIndicatorSelected}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
