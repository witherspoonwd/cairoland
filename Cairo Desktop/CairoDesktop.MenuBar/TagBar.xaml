<UserControl x:Class="CairoDesktop.MenuBar.TagBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             Height="22"
             VerticalAlignment="Center"
             PreviewMouseWheel="TagBar_PreviewMouseWheel">
    <ItemsControl ItemsSource="{Binding Tags}"
                  Focusable="False"
                  Margin="2,0,6,0">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="TagBorder"
                        Width="22"
                        Height="20"
                        Margin="1,1,1,1"
                        CornerRadius="2"
                        Background="Transparent"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding ViewCommand}" />
                        <MouseBinding MouseAction="RightClick"
                                      Command="{Binding MoveHereCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <TextBlock x:Name="TagLabel"
                                   Text="{Binding Label}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MenuHeaderForeground}"
                                   Opacity="{DynamicResource TilingTagEmptyOpacity}" />
                        <Rectangle x:Name="OccupiedMark"
                                   Height="2"
                                   Width="10"
                                   RadiusX="1"
                                   RadiusY="1"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,1"
                                   Fill="{DynamicResource MenuHeaderForeground}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="TagBorder"
                             Property="IsMouseOver"
                             Value="True">
                        <Setter TargetName="TagBorder"
                                Property="Background"
                                Value="{DynamicResource MenuHeaderHoverBackground}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsOccupied}"
                                 Value="True">
                        <Setter TargetName="TagLabel"
                                Property="Opacity"
                                Value="1" />
                        <Setter TargetName="OccupiedMark"
                                Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsUrgent}"
                                 Value="True">
                        <Setter TargetName="TagBorder"
                                Property="Background"
                                Value="{DynamicResource TilingTagUrgentBackground}" />
                        <Setter TargetName="TagLabel"
                                Property="Opacity"
                                Value="1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}"
                                 Value="True">
                        <Setter TargetName="TagBorder"
                                Property="Background"
                                Value="{DynamicResource MenuItemHoverGradient}" />
                        <Setter TargetName="TagLabel"
                                Property="FontWeight"
                                Value="Bold" />
                        <Setter TargetName="TagLabel"
                                Property="Opacity"
                                Value="1" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
