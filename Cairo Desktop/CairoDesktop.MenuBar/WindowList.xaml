<UserControl x:Class="CairoDesktop.MenuBar.WindowList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:CairoDesktop.Common.Localization;assembly=CairoDesktop.Common"
             xmlns:control="clr-namespace:CairoDesktop.MenuBar"
             Focusable="False"
             Height="{DynamicResource RunchBarHeight}"
             Background="{DynamicResource RunchDark}">
    <ItemsControl ItemsSource="{Binding Windows}"
                  Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <control:WindowListPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="ItemBorder"
                        Height="{DynamicResource RunchBarHeight}"
                        Padding="8,0"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip="{Binding Title}"
                        MouseUp="Item_MouseUp">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding Path=(l10n:DisplayString.sWindowManager_Float)}"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsFloating, Mode=OneWay}"
                                      Command="{Binding ToggleFloatingCommand}" />
                            <MenuItem Header="{Binding Path=(l10n:DisplayString.sWindowManager_MoveToTag)}">
                                <MenuItem Header="1" Command="{Binding MoveToTagCommand}" CommandParameter="0" />
                                <MenuItem Header="2" Command="{Binding MoveToTagCommand}" CommandParameter="1" />
                                <MenuItem Header="3" Command="{Binding MoveToTagCommand}" CommandParameter="2" />
                                <MenuItem Header="4" Command="{Binding MoveToTagCommand}" CommandParameter="3" />
                                <MenuItem Header="5" Command="{Binding MoveToTagCommand}" CommandParameter="4" />
                                <MenuItem Header="6" Command="{Binding MoveToTagCommand}" CommandParameter="5" />
                                <MenuItem Header="7" Command="{Binding MoveToTagCommand}" CommandParameter="6" />
                                <MenuItem Header="8" Command="{Binding MoveToTagCommand}" CommandParameter="7" />
                                <MenuItem Header="9" Command="{Binding MoveToTagCommand}" CommandParameter="8" />
                                <MenuItem Header="0" Command="{Binding MoveToTagCommand}" CommandParameter="9" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{Binding Path=(l10n:DisplayString.sCommand_TilingCloseWindow)}"
                                      Command="{Binding CloseCommand}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <DockPanel LastChildFill="True">
                        <Image x:Name="AppIcon"
                               Source="{Binding Icon, TargetNullValue={StaticResource RunchWindowFallbackIcon}}"
                               Width="16"
                               Height="16"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="FloatingMark"
                                   Text="&#x25C7;"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right"
                                   FontFamily="{DynamicResource RunchFontFamily}"
                                   FontSize="{DynamicResource RunchFontSize}"
                                   Foreground="{DynamicResource RunchForeground}"
                                   Opacity="0.7"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="TitleText"
                                   Text="{Binding Title}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource RunchFontFamily}"
                                   FontSize="{DynamicResource RunchFontSize}"
                                   Foreground="{DynamicResource RunchForeground}" />
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="ItemBorder"
                             Property="IsMouseOver"
                             Value="True">
                        <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource RunchTopHover}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsFloating}"
                                 Value="True">
                        <Setter TargetName="FloatingMark"
                                Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFocused}"
                                 Value="True">
                        <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource RunchTopSelected}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
